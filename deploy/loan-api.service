[Unit]
Description=loan-poc API (agent server, REST + WebSocket) on 127.0.0.1:4000
After=network.target loan-mocks.service
Wants=loan-mocks.service

[Service]
Type=simple
User=loanpoc
Group=loanpoc
WorkingDirectory=/opt/loan-poc/current
EnvironmentFile=/opt/loan-poc/.env
# Note: values in EnvironmentFile override these, so keep HOST/TRUST_PROXY/EVENT_LOG_DIR out of /opt/loan-poc/.env.
# Loopback only (nginx is the public entry); trust nginx's X-Forwarded-For.
Environment=NODE_ENV=production
Environment=PORT=4000
Environment=HOST=127.0.0.1
Environment=TRUST_PROXY=1
Environment=MOCK_BASE_URL=http://127.0.0.1:4100
Environment=EVENT_LOG_DIR=/opt/loan-poc/data/events
# Node 22 at /usr/bin/node (bootstrap checks it). Units change only through `scripts/deploy.sh bootstrap`.
ExecStart=/usr/bin/node --import tsx apps/server/src/main.ts
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RemoveIPC=yes
# No access to the GCE metadata server (VM service-account tokens); loopback and outbound internet stay allowed.
IPAddressDeny=169.254.169.254/32
# The only writable path (event log); /tmp is private (tsx compile cache).
ReadWritePaths=/opt/loan-poc/data

[Install]
WantedBy=multi-user.target
