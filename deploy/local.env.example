# Copy to deploy/local.env (git-ignored) and fill in. scripts/deploy.sh loads it if present; variables already set in
# the environment win. For the shell commands in deploy/SETUP.md: `set -a; . deploy/local.env; set +a`.
GCP_PROJECT=
VM_NAME=
VM_ZONE=
# The VM's static external IP or DNS name (SSH target for deploys, and the host in the pinned known_hosts line).
DEPLOY_HOST=
# Space-separated nginx site names of other tenants on the same VM; bootstrap aborts if any of them changes.
PROTECTED_NGINX_SITES=
API_DOMAIN=api.sparsan.com
WEB_DOMAIN=loans.sparsan.com
