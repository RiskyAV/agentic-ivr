#!/bin/bash
# /usr/local/sbin/loan-poc-activate <release-id>   (root-owned; installed by `scripts/deploy.sh bootstrap`)
#
# The ONLY command the deploy user may run with sudo. It activates a release tarball uploaded (by the SSH gate) to
# /opt/loan-poc/incoming/<id>.tgz + <id>.sha256.
#
# Privilege boundaries (why it is built this way):
#  - Inputs are read AS loandeploy (`runuser -u loandeploy -- head`) into a root-only staging dir (/run/loan-poc,
#    700) once, under the deploy lock; every check and the extraction use only that private copy, and the upload is
#    deleted on every exit path. Root never opens a path loandeploy controls.
#  - The listing must contain only regular files and directories with relative paths (no symlinks, hardlinks,
#    devices, fifos, absolute paths, "..") and no .npmrc / .yarnrc* anywhere.
#  - Extraction and `npm ci --omit=dev --ignore-scripts --git=/bin/false` (user/global npm config = empty root-owned files) run as
#    the dedicated build user `loanbuild` in a transient systemd unit (`systemd-run --wait`): own cgroup killed at
#    the end (KillMode=control-group), ProtectSystem=strict with the build dir as the only writable path,
#    PrivateTmp, PrivateDevices, PrivateIPC/RemoveIPC, NoNewPrivileges, RestrictSUIDSGID, memory and runtime caps,
#    and no network access to the GCE metadata server or to any loopback service except the systemd-resolved stub
#    (127.0.0.53, so npm can resolve the registry; IPAddressAllow takes precedence over IPAddressDeny). Afterwards every
#    loanbuild process is killed and the script aborts if any survives, so build-time code cannot persist.
#  - The build dir (loanbuild 700, holding the tree and a per-build npm cache that is discarded) lives under the
#    root-owned 711 releases/.build, unreachable by the live app (loanpoc) and by loandeploy. After the kill, root
#    locks the top dir (root:root 700), aborts if any regular file has more than one link (planted hardlink), then
#    runs `chown -R -P -h` (no link is followed; links themselves are changed) and `chmod -R` (GNU chmod skips
#    symlinks met during recursion) before moving the tree into releases/<id>.
#  - It never installs systemd units, nginx config or sudoers from the tarball (those change only via bootstrap),
#    so a deploy can at most run new application code as `loanpoc`.
# Flow: stage -> verify -> sandboxed build -> lock down -> atomic `current` swap -> restart -> health check ->
# roll back (or, on a first deploy, stop and remove) on failure -> prune.
set -euo pipefail
umask 022
export LC_ALL=C
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
cd /

APP=/opt/loan-poc
IN="$APP/incoming"
REL="$APP/releases"
BUILD_PARENT="$REL/.build"
STAGE=/run/loan-poc
LOCK=/var/lib/loan-poc/deploy.lock
BUILD_USER=loanbuild
UPLOAD_USER=loandeploy
MAX_BYTES=$((50 * 1024 * 1024))
KEEP=5

die() { echo "activate: $*" >&2; exit 1; }

[ "$#" -eq 1 ] || die "usage: loan-poc-activate <YYYYMMDDTHHMMSS-gitsha>"
ID="$1"
[[ "$ID" =~ ^[0-9]{8}T[0-9]{6}-[0-9a-f]{7,40}$ ]] || die "invalid release id"
command -v systemd-run >/dev/null || die "systemd-run is required"

install -d -o root -g root -m 755 "$(dirname "$LOCK")"
[ -f "$LOCK" ] || install -o root -g "$UPLOAD_USER" -m 640 /dev/null "$LOCK"
exec 9<"$LOCK"
flock -n 9 || die "another deploy step is running"

install -d -o root -g root -m 700 "$STAGE"
STGZ="$STAGE/$ID.tgz"
SSUM="$STAGE/$ID.sha256"
T=""
cleanup() {
  rm -f -- "$STGZ" "$SSUM" "$IN/$ID.tgz" "$IN/$ID.sha256"   # rm never follows a symlink
  if [ -n "$T" ] && [ -d "$T" ]; then rm -rf -- "$T"; fi
}
trap cleanup EXIT

echo "--> stage $ID (read as $UPLOAD_USER, root-only copy)"
runuser -u "$UPLOAD_USER" -- head -c $((MAX_BYTES + 1)) -- "$IN/$ID.tgz" > "$STGZ" 9<&- || die "cannot read upload $ID.tgz"
runuser -u "$UPLOAD_USER" -- head -c 200 -- "$IN/$ID.sha256" > "$SSUM" 9<&- || die "cannot read $ID.sha256"
rm -f -- "$IN/$ID.tgz" "$IN/$ID.sha256"

echo "--> verify"
size=$(stat -c %s "$STGZ")
[ "$size" -gt 0 ] && [ "$size" -le "$MAX_BYTES" ] || die "tarball size $size out of range"
grep -Eqx "[0-9a-f]{64}  $ID\.tgz" "$SSUM" || die "malformed checksum file"
[ "$(sha256sum "$STGZ" | cut -d' ' -f1)" = "$(cut -d' ' -f1 "$SSUM")" ] || die "checksum mismatch"
listing="$(tar -tvzf "$STGZ")" || die "not a readable tar.gz"
if printf '%s\n' "$listing" | awk '{print substr($1,1,1)}' | grep -qv '^[-d]$'; then
  die "archive has links, devices, fifos or other special entries"
fi
names="$(tar -tzf "$STGZ")"
if printf '%s\n' "$names" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then die "archive has unsafe paths"; fi
if printf '%s\n' "$names" | grep -Eq '(^|/)\.(npmrc|yarnrc[^/]*)/?$'; then die "archive contains .npmrc/.yarnrc"; fi

R="$REL/$ID"
[ ! -e "$R" ] || die "release $ID already exists"
PREV=""
if [ -L "$APP/current" ]; then PREV="$(readlink -e "$APP/current" 2>/dev/null || true)"; fi
case "$PREV" in "$REL"/*) ;; *) PREV="" ;; esac

echo "--> sandboxed build as $BUILD_USER (systemd-run: extract, npm ci --omit=dev --ignore-scripts)"
install -d -o root -g root -m 711 "$BUILD_PARENT"
T="$BUILD_PARENT/$ID"
rm -rf -- "$T"
install -d -o "$BUILD_USER" -g "$BUILD_USER" -m 700 "$T" "$T/app" "$T/npm-cache"
# Empty, root-owned npm user/global config (npm refuses the same file for both, so two files).
NPMRC_DIR=/run/loan-poc-npmrc
install -d -o root -g root -m 755 "$NPMRC_DIR"
install -o root -g root -m 444 /dev/null "$NPMRC_DIR/user"
install -o root -g root -m 444 /dev/null "$NPMRC_DIR/global"
# shellcheck disable=SC2016  # the script below is expanded by the sandboxed bash, not here
systemd-run --wait --pipe --collect --quiet --unit "loan-poc-build-$ID" \
  -p User="$BUILD_USER" -p Group="$BUILD_USER" -p WorkingDirectory="$T" \
  -p KillMode=control-group -p ProtectSystem=strict -p ProtectHome=yes -p PrivateTmp=yes -p PrivateDevices=yes \
  -p NoNewPrivileges=yes -p RestrictSUIDSGID=yes -p ReadWritePaths="$T" \
  -p MemoryMax=1G -p RuntimeMaxSec=600 -p RemoveIPC=yes -p PrivateIPC=yes \
  -p IPAddressDeny=169.254.169.254/32 -p "IPAddressDeny=127.0.0.0/8 ::1/128" -p IPAddressAllow=127.0.0.53/32 \
  -E LC_ALL=C -E HOME="$T" -E npm_config_cache="$T/npm-cache" \
  -E npm_config_userconfig="$NPMRC_DIR/user" -E npm_config_globalconfig="$NPMRC_DIR/global" -E npm_config_update_notifier=false \
  /bin/bash -c 'set -euo pipefail
    tar --no-same-owner --no-same-permissions -xzf - -C app
    cd app
    npm ci --omit=dev --ignore-scripts --git=/bin/false --no-audit --no-fund \
      --workspace @app/server --workspace @app/mock-systems --include-workspace-root' \
  < "$STGZ" 9<&- || die "sandboxed build failed; nothing changed"

echo "--> stop every $BUILD_USER process, then lock down"
pkill -KILL -u "$BUILD_USER" 9<&- || true
sleep 0.2
if pgrep -u "$BUILD_USER" >/dev/null; then die "$BUILD_USER processes survived the build; aborting"; fi
chown root:root "$T"; chmod 700 "$T"           # nothing below is reachable by non-root from here on
if [ -n "$(find "$T/app" -type f -links +1 -print -quit)" ]; then die "build produced hardlinked files; aborting"; fi
chown -R -P -h root:root "$T/app"               # -P: never traverse links; -h: change links, not their targets
chmod -R u+rwX,go+rX,go-w "$T/app"              # GNU chmod -R does not follow symlinks met during recursion
chmod 755 "$T/app"
mv -T -- "$T/app" "$R"
rm -rf -- "$T"
T=""

healthy() {
  for _ in $(seq 1 30); do
    if node -e "fetch('http://127.0.0.1:4000/api/health').then(r=>r.json()).then(b=>process.exit(b.ok===true?0:1),()=>process.exit(1))" 2>/dev/null; then
      return 0
    fi
    sleep 1
  done
  return 1
}

swap_to() { ln -sfn "$1" "$APP/current.new" && mv -T "$APP/current.new" "$APP/current"; }

echo "--> activate"
swap_to "$R"
systemctl restart loan-mocks loan-api 9<&-
if healthy; then
  echo "    healthy: $ID is live"
else
  echo "activate: $ID failed its health check" >&2
  journalctl -u loan-api -n 30 --no-pager >&2 || true
  if [ -n "$PREV" ] && [ -d "$PREV" ] && [ "$PREV" != "$R" ]; then
    echo "--> rolling back to $(basename "$PREV")" >&2
    swap_to "$PREV"
    systemctl restart loan-mocks loan-api 9<&-
    if healthy; then echo "    rollback healthy" >&2; else echo "activate: rollback is not healthy either" >&2; fi
  else
    echo "--> first deploy failed: stopping the units and removing the release" >&2
    systemctl stop loan-api loan-mocks 9<&- || true
    rm -f -- "$APP/current"
  fi
  rm -rf -- "$R"
  exit 1
fi

echo "--> prune (keep $KEEP)"
find "$REL" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%T@ %p\n' | sort -rn | tail -n +$((KEEP + 1)) | cut -d' ' -f2- |
  while read -r old; do
    [ "$old" = "$R" ] || [ "$old" = "$PREV" ] || rm -rf -- "$old"
  done
