#!/bin/bash
# /usr/local/sbin/loan-poc-activate <release-id>   (root-owned; installed by `scripts/deploy.sh bootstrap`)
#
# The ONLY command the deploy user may run with sudo. It activates a release tarball that was uploaded to
# /opt/loan-poc/incoming/<id>.tgz (+ <id>.sha256): verify -> unpack -> npm ci as the runtime user (no install
# scripts) -> atomic `current` swap -> restart -> local health check -> roll back on failure -> prune.
# It never installs systemd units or nginx config from the tarball: those change only through bootstrap
# (run by the owner), so a deploy can at most run new app code as the unprivileged runtime user.
set -euo pipefail
umask 022
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

APP=/opt/loan-poc
IN="$APP/incoming"
REL="$APP/releases"
RUN_USER=loanpoc
MAX_BYTES=$((50 * 1024 * 1024))
KEEP=5

die() { echo "activate: $*" >&2; exit 1; }

[ "$#" -eq 1 ] || die "usage: loan-poc-activate <YYYYMMDDTHHMMSS-gitsha>"
ID="$1"
[[ "$ID" =~ ^[0-9]{8}T[0-9]{6}-[0-9a-f]{7,40}$ ]] || die "invalid release id"

exec 9>/run/loan-poc-activate.lock
flock -n 9 || die "another activation is running"

TGZ="$IN/$ID.tgz"
SUM="$IN/$ID.sha256"
cleanup_incoming() { rm -f -- "$TGZ" "$SUM"; }

echo "--> verify $ID"
[ -f "$TGZ" ] && [ ! -L "$TGZ" ] || die "missing $TGZ"
[ -f "$SUM" ] && [ ! -L "$SUM" ] || die "missing $SUM"
size=$(stat -c %s "$TGZ")
[ "$size" -gt 0 ] && [ "$size" -le "$MAX_BYTES" ] || { cleanup_incoming; die "tarball size $size out of range"; }
grep -Eqx "[0-9a-f]{64}  $ID\.tgz" "$SUM" || { cleanup_incoming; die "malformed checksum file"; }
(cd "$IN" && sha256sum --check --status --strict "$ID.sha256") || { cleanup_incoming; die "checksum mismatch"; }
# Only regular files and directories, relative paths, no "..".
if tar -tvzf "$TGZ" | awk '{print substr($1,1,1)}' | grep -qv '^[-d]$'; then cleanup_incoming; die "tarball has links or special files"; fi
if tar -tzf "$TGZ" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then cleanup_incoming; die "tarball has unsafe paths"; fi

R="$REL/$ID"
[ ! -e "$R" ] || { cleanup_incoming; die "release $ID already exists"; }
PREV="$(readlink -f "$APP/current" 2>/dev/null || true)"

echo "--> unpack and install production dependencies (as $RUN_USER, --ignore-scripts)"
install -d -o "$RUN_USER" -g "$RUN_USER" -m 755 "$R"
tar -xzf "$TGZ" -C "$R" --no-same-owner --no-same-permissions
chown -R "$RUN_USER:$RUN_USER" "$R"
install -d -o "$RUN_USER" -g "$RUN_USER" -m 700 "$APP/.npm"
if ! (cd "$R" && runuser -u "$RUN_USER" -- env HOME="$APP" npm_config_cache="$APP/.npm" \
      npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
      --workspace @app/server --workspace @app/mock-systems --include-workspace-root); then
  rm -rf -- "$R"; cleanup_incoming; die "npm ci failed; nothing changed"
fi
# Code is read-only to the runtime user from here on.
chown -R root:root "$R"
chmod -R u+rwX,go+rX,go-w "$R"
cleanup_incoming

healthy() {
  for _ in $(seq 1 30); do
    if node -e "fetch('http://127.0.0.1:4000/api/health').then(r=>r.json()).then(b=>process.exit(b.ok===true?0:1),()=>process.exit(1))" 2>/dev/null; then
      return 0
    fi
    sleep 1
  done
  return 1
}

swap_to() { ln -sfn "$1" "$APP/current.new" && mv -T "$APP/current.new" "$APP/current"; }

echo "--> activate"
swap_to "$R"
systemctl restart loan-mocks loan-api 9>&-
if healthy; then
  echo "    healthy: $ID is live"
else
  echo "activate: $ID failed its health check" >&2
  journalctl -u loan-api -n 30 --no-pager >&2 || true
  if [ -n "$PREV" ] && [ -d "$PREV" ]; then
    echo "--> rolling back to $(basename "$PREV")" >&2
    swap_to "$PREV"
    systemctl restart loan-mocks loan-api 9>&-
    if healthy; then echo "    rollback healthy" >&2; else echo "activate: rollback is not healthy either" >&2; fi
    rm -rf -- "$R"
  fi
  exit 1
fi

echo "--> prune (keep $KEEP)"
find "$REL" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -rn | tail -n +$((KEEP + 1)) | cut -d' ' -f2- |
  while read -r old; do
    [ "$old" = "$R" ] || [ "$old" = "$PREV" ] || rm -rf -- "$old"
  done
