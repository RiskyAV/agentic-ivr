GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_GUARD_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=gemini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
STT_SILENCE_SECS=0.45
# Barge-in: real words in a partial transcript that interrupt the assistant (keywords like 'stop' always do)
BARGE_IN_MIN_WORDS=2
# Barge-in on sustained mic energy (ms over BARGE_IN_VAD_DB dBFS) before any transcript; 0 = transcripts only
BARGE_IN_VAD_MS=500
BARGE_IN_VAD_DB=-40
# ...and at least this many dB above the adaptive noise floor
BARGE_IN_VAD_MARGIN_DB=15
# Speak a tool filler only if no audio has gone out this long after the user's turn ended
FILLER_AFTER_MS=700
DEMO_TODAY=2026-10-25
DEMO_ACCESS_CODE=
# Each login resets that customer's mock requests, payment links and idempotency entries (0 = off).
DEMO_RESET_ON_LOGIN=1
SESSION_SECRET=
PORT=4000
MOCK_PORT=4100
MOCK_BASE_URL=http://127.0.0.1:4100
LLM_MAX_CONCURRENCY=50
LLM_QUEUE_TIMEOUT_MS=4000
MAX_VOICE_SESSIONS=5
# Voice stops after this long without a committed transcript or assistant audio, and after VOICE_MAX_MS in total.
# One voice session per customer: a new one stops the older one.
VOICE_IDLE_MS=120000
VOICE_MAX_MS=900000
TURN_BUDGET_MS=9000
# Optional override: minimal|low|medium|high|off|<token budget>. Unset = auto per model (2.5: budget 0, 3.x: low).
GEMINI_THINKING=

# Max wait (ms) for the malicious-input guard verdict once the answer is ready (classifier takes ~1.0-1.4 s).
GUARD_WAIT_MS=2000
# Comma-separated extra browser origins allowed by CORS (the Vite dev origin is always allowed).
WEB_ORIGIN=
# Rate limits: logins per IP per minute, user turns per session per minute.
LOGIN_RATE_PER_MIN=10
TURN_RATE_PER_MIN=30
# LLM_PROVIDER=stub only: delay (ms) per scripted chunk, to model model latency in load tests (npm run load sets 600).
STUB_CHUNK_DELAY_MS=0
